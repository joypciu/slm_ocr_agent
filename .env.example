OMNI_API_KEYS=replace-with-a-private-key
OMNI_LLM_URL=http://127.0.0.1:8081
OMNI_VISION_URL=http://127.0.0.1:8082
# Optional: use AI Gateway instead of calling model servers directly.
# URLs omit /v1 because the clients append it.
# OMNI_LLM_URL=http://127.0.0.1:8080
# OMNI_VISION_URL=http://127.0.0.1:8080
# OMNI_UPSTREAM_API_KEY=your-gateway-user-key
# OMNI_UPSTREAM_MODEL=local/qwen
# OMNI_UPSTREAM_VISION_MODEL=local/smolvlm
# Optional explicit chat backend (otherwise text/vision routes use the URLs above).
# SLM_BACKEND=http://127.0.0.1:8080
